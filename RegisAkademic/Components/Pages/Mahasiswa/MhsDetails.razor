@page "/mahasiswa/detail/{Id:int}"
@using System.Net.Http.Json
@using NamaProjectFrontend.DTO
@inject HttpClient Http

<PageTitle>Detail Mahasiswa - Sistem Akademik</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Manajemen Akademik / Mahasiswa</div>
        <h1>Detail Mahasiswa</h1>
        <p>Informasi lengkap mahasiswa dan dosen walinya.</p>
    </div>

    <a href="/mahasiswa" class="btn btn-secondary">
        ← Kembali
    </a>
</div>

@if (loading)
{
    <div class="card loading-state">Memuat detail mahasiswa...</div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="notice notice-error">@errorMessage</div>
}
else if (mahasiswa is not null)
{
    <div class="detail-grid">
        <section class="card profile-card">
            <div class="detail-avatar">♧</div>
            <div class="eyebrow">Profil Mahasiswa</div>
            <h2>@mahasiswa.NamaMahasiswa</h2>
            <p class="detail-muted">NIM: @mahasiswa.Nim</p>

            <div class="detail-info">
                <div>
                    <span>NIM</span>
                    <strong>@mahasiswa.Nim</strong>
                </div>
                <div>
                    <span>Email</span>
                    <strong>@mahasiswa.Email</strong>
                </div>
                <div>
                    <span>Angkatan</span>
                    <strong>@mahasiswa.Angkatan</strong>
                </div>
            </div>

            <a class="btn btn-primary"
               href="/mahasiswa">
                Kembali ke Data Mahasiswa
            </a>
        </section>

        <section class="card">
            <div class="eyebrow">Informasi Akademik</div>
            <h2>Dosen Wali</h2>

            @if (dosenWali is not null)
            {
                <div class="advisor-card">
                    <div class="detail-avatar">♙</div>
                    <div>
                        <h3>@dosenWali.NamaDosen</h3>
                        <p class="detail-muted">@dosenWali.Prodi</p>
                        <p>@dosenWali.Email</p>
                        <p class="detail-muted">NIDN: @dosenWali.Nidn</p>
                    </div>
                </div>

                <a class="btn btn-secondary"
                   href="@($"/dosen/detail/{dosenWali.DosenId}")">
                    Lihat Detail Dosen →
                </a>
            }
            else
            {
                <div class="notice notice-info">
                    Data dosen wali belum ditemukan atau belum ditetapkan.
                </div>
            }
        </section>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MahasiswaDto? mahasiswa;
    private DosenDto? dosenWali;
    private bool loading = true;
    private string errorMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        errorMessage = "";

        try
        {
            var semuaMahasiswa =
                await Http.GetFromJsonAsync<List<MahasiswaDto>>("api/Mahasiswa")
                ?? new();

            var semuaDosen =
                await Http.GetFromJsonAsync<List<DosenDto>>("api/Dosen")
                ?? new();

            mahasiswa = semuaMahasiswa.FirstOrDefault(m => m.MahasiswaId == Id);

            if (mahasiswa is null)
            {
                errorMessage = "Data mahasiswa tidak ditemukan.";
                return;
            }

            dosenWali = semuaDosen.FirstOrDefault(
                d => d.DosenId == mahasiswa.DosenId);
        }
        catch (Exception ex)
        {
            errorMessage = "Gagal memuat detail mahasiswa: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
