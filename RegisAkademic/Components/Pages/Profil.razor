@page "/profil"

<PageTitle>Profil - Sistem Akademik</PageTitle>

<div class="page-heading">
    <div>
        <div class="eyebrow">Pengaturan Akun</div>
        <h1>Profil</h1>
        <p>Informasi administrator Sistem Informasi Akademik.</p>
    </div>
</div>

<div class="detail-grid">
    <section class="card profile-card">
        <div class="detail-avatar">A</div>
        <div class="eyebrow">Administrator</div>
        <h2>Administrator</h2>
        <p class="detail-muted">
            Pengelola Sistem Informasi Akademik
        </p>

        <span class="badge">Administrator</span>
    </section>

    <section class="card">
        <div class="eyebrow">Informasi Akun</div>
        <h2>Informasi Profil</h2>

        <div class="detail-info">
            <div>
                <span>Nama pengguna</span>
                <strong>Administrator</strong>
            </div>
            <div>
                <span>Peran</span>
                <strong>Pengelola akademik</strong>
            </div>
            <div>
                <span>Aplikasi</span>
                <strong>Sistem Informasi Akademik</strong>
            </div>
        </div>

        <div class="notice notice-info">
            Informasi ini masih berupa profil statis.
            Pengelolaan akun dan perubahan profil dapat ditambahkan
            setelah sistem akun tersedia.
        </div>
    </section>
</div>
